rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    /* ==============================
       USERS
    ============================== */
    match /users/{userId} {
      allow read, create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && request.auth.uid == userId;
      
      match /capsules/{capId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    /* ==============================
       CLASSES
    ============================== */
    match /classes/{classId} {
      // Autorise la lecture si l'utilisateur fait partie des memberIds
      // C'est cette règle qui permet à la requête array-contains de fonctionner
      allow read: if request.auth != null && request.auth.uid in resource.data.memberIds;

      // Seul le créateur peut modifier ou supprimer
      allow update, delete: if request.auth != null && resource.data.teacherId == request.auth.uid;
      
      // La création se fait via Cloud Functions (Admin SDK)
      allow create: if false;

      match /capsules/{capId} {
        allow read: if request.auth != null && 
          get(/databases/$(database)/documents/classes/$(classId)).data.memberIds.hasAny([request.auth.uid]);
          
        allow write: if request.auth != null && 
          get(/databases/$(database)/documents/classes/$(classId)).data.teacherId == request.auth.uid;
      }
    }

    /* ==============================
       INVITATIONS
    ============================== */
    match /invitations/{code} {
      allow read: if request.auth != null;
      allow write: if false;
    }
  }
}