rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    /* ==============================
       USERS (Profil & Préférences)
    ============================== */
    match /users/{userId} {
      allow read, create: if request.auth != null && request.auth.uid == userId;

      allow update: if request.auth != null && request.auth.uid == userId
                    && !request.resource.data.diff(resource.data).affectedKeys()
                        .hasAny(['plan', 'isPremium']);
      
      match /capsules/{capId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    /* ==============================
       CLASSES (Groupes d'étude)
    ============================== */
    match /classes/{classId} {
      // Pour une requête de liste (query), la règle doit être simple
      // On autorise la lecture si l'utilisateur est présent dans memberIds
      allow read: if request.auth != null && request.auth.uid in resource.data.memberIds;

      // Seul l'enseignant (owner/teacherId) peut modifier ou supprimer
      allow update, delete: if request.auth != null && resource.data.teacherId == request.auth.uid;
      
      // La création est exclusivement réservée au serveur (Admin SDK)
      allow create: if false;

      // MODULES PARTAGÉS DANS LA CLASSE
      match /capsules/{capId} {
        allow read: if request.auth != null && 
          exists(/databases/$(database)/documents/classes/$(classId)) &&
          request.auth.uid in get(/databases/$(database)/documents/classes/$(classId)).data.memberIds;
          
        allow write: if request.auth != null && 
          exists(/databases/$(database)/documents/classes/$(classId)) &&
          get(/databases/$(database)/documents/classes/$(classId)).data.teacherId == request.auth.uid;
      }
    }

    /* ==============================
       INVITATIONS (Codes d'accès)
    ============================== */
    match /invitations/{code} {
      allow read: if request.auth != null;
      allow write: if false;
    }
  }
}