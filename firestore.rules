rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /* ================= USERS ================= */
    match /users/{userId} {
      // Permission totale sur son propre document pour simplifier
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      // Sous-collections (modules, etc.)
      match /{allSubcollections=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    /* ================= CLASSES ================= */
    match /classes/{classId} {
      // 🔓 Lecture si membre ou enseignant
      allow read: if request.auth != null && (
        request.auth.uid in resource.data.get('memberIds', []) || 
        request.auth.uid == resource.data.get('teacherId', '')
      );

      // Écritures via Cloud Functions uniquement
      allow write: if false;

      match /modules/{moduleId} {
        allow read: if request.auth != null;
      }
      
      match /members/{memberId} {
        allow read: if request.auth != null;
      }
    }

    /* ================= INVITATIONS ================= */
    match /invitations/{code} {
      allow read, write: if false;
    }
  }
}