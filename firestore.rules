rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /classes/{classId} {
      allow read, write: if request.auth != null &&
        (resource.data.teacherId == request.auth.uid || isMemberOfClass(request.auth.uid, classId));

      match /members/{memberId} {
        allow read, write: if request.auth != null && request.auth.uid == memberId;
      }
    }

    match /invitations/{inviteCode} {
      allow read, write: if request.auth != null;
    }
  }

  function isMemberOfClass(userId, classId) {
    return exists(/databases/$(database)/documents/classes/$(classId)/members/$(userId));
  }
}
