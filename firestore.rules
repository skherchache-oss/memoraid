rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    /* ==============================
       USERS (Profil & Préférences)
    ============================== */
    match /users/{userId} {
      allow read, create: if request.auth != null && request.auth.uid == userId;

      allow update: if request.auth != null && request.auth.uid == userId
                    && !request.resource.data.diff(resource.data).affectedKeys()
                        .hasAny(['plan', 'isPremium']);
      
      match /capsules/{capId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    /* ==============================
       CLASSES (Groupes d'étude)
    ============================== */
    match /classes/{classId} {
      // Autorise la lecture si l'UID est dans memberIds OU si l'utilisateur est le professeur
      // Utilisation de .get() pour éviter les erreurs si le champ n'existe pas sur un vieux doc
      allow read: if request.auth != null && (
        request.auth.uid in resource.data.get('memberIds', []) || 
        resource.data.get('teacherId', '') == request.auth.uid
      );

      // La création est gérée par Cloud Functions (Admin SDK)
      allow create: if false;

      // Seul l'enseignant peut modifier/supprimer la classe
      allow update, delete: if request.auth != null && 
        resource.data.get('teacherId', '') == request.auth.uid;

      // MODULES PARTAGÉS DANS LA CLASSE
      match /capsules/{capId} {
        allow read: if request.auth != null && 
          request.auth.uid in get(/databases/$(database)/documents/classes/$(classId)).data.get('memberIds', []);
          
        allow write: if request.auth != null && 
          get(/databases/$(database)/documents/classes/$(classId)).data.get('teacherId', '') == request.auth.uid;
      }
    }

    /* ==============================
       INVITATIONS (Codes d'accès)
    ============================== */
    match /invitations/{code} {
      allow read: if request.auth != null;
      allow write: if false;
    }
  }
}