rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    /* ==============================
       USERS
    ============================== */
    match /users/{userId} {
      allow read, create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && request.auth.uid == userId;
      
      match /capsules/{capId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    /* ==============================
       CLASSES
    ============================== */
    match /classes/{classId} {
      // Version ultra-défensive pour supporter les requêtes de filtrage
      allow read: if request.auth != null && (
        request.auth.uid in resource.data.get('memberIds', []) || 
        resource.data.get('teacherId', '') == request.auth.uid
      );

      allow update, delete: if request.auth != null && 
        resource.data.get('teacherId', '') == request.auth.uid;
      
      allow create: if false; // Via Cloud Functions uniquement

      match /capsules/{capId} {
        allow read: if request.auth != null && 
          get(/databases/$(database)/documents/classes/$(classId)).data.get('memberIds', []).hasAny([request.auth.uid]);
          
        allow write: if request.auth != null && 
          get(/databases/$(database)/documents/classes/$(classId)).data.get('teacherId', '') == request.auth.uid;
      }
    }

    /* ==============================
       INVITATIONS
    ============================== */
    match /invitations/{code} {
      allow read: if request.auth != null;
      allow write: if false;
    }
  }
}